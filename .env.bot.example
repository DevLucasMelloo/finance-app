# Chave de autenticação da Evolution API (escolha qualquer string segura)
EVOLUTION_API_KEY=troque_esta_chave_secreta

# Nome da instância criada na Evolution API
EVOLUTION_INSTANCE=finance-bot

# Número(s) autorizado(s) a usar o bot (código do país + DDD + número, sem + ou -)
# Separe múltiplos números com vírgula
ALLOWED_NUMBERS=5511999999999

# String de conexão PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
